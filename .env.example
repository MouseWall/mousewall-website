# Canonical site URL — used for metadata / sitemap / Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.mousewall.com

# OPTIONAL — only needed if you use the contact form on /contact.
# This is a PUBLIC key (safe to expose in the client bundle). It only forwards
# submissions to the inbox configured in your Web3Forms account — there is no
# private secret and nothing for the owner to log into.
# Get a key at https://web3forms.com (enter info@mousewall.com as the inbox).
# If this is left blank, the form simply tells visitors to email directly.
NEXT_PUBLIC_WEB3FORMS_KEY=
